<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android布局实验"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实验1：线性布局"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实验2：表格布局"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_calculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实验3：约束布局1（计算器）"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实验4：约束布局2（太空旅行）"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实验5：Compose任务列表" />

</LinearLayout>
